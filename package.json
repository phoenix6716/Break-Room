{
  "name": "break-room",
  "version": "1.0.0",
  "private": true,
  "description": "Break Room static daily games and browser regression checks",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build-site.cjs",
    "check": "node scripts/check-site.cjs dist",
    "test:unit": "node scripts/run-checks.cjs unit",
    "test:browser": "node scripts/run-checks.cjs browser",
    "test": "node scripts/affected-checks.cjs",
    "content:studio": "node scripts/content-studio.cjs",
    "content:check": "node scripts/content.cjs check",
    "content:report": "node scripts/content.cjs report",
    "content:export": "node scripts/content.cjs export",
    "game:new": "node scripts/new-game.cjs",
    "legal:sync": "node scripts/sync-legal-footer.cjs",
    "legal:check": "node scripts/sync-legal-footer.cjs --check",
    "test:all": "node scripts/affected-checks.cjs --full"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  }
}
